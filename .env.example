# SentiMind configuration. Copy to `.env` at the repo root (start.sh does this
# for you) and fill in the values. One file serves both halves of the app:
# the backend reads `.env` / `../.env`, and Vite uses `envDir: "../"`.
# Never commit the real `.env`.

# ── Backend ────────────────────────────────────────────────────────────────

# HuggingFace Inference API token, used for emotion detection
# (j-hartmann/emotion-english-distilroberta-base). Without it, emotions fall
# back to {"neutral": 1.0}.
HF_API_TOKEN=

# OpenRouter, used for the LLM insight and the chat agent.
OPENROUTER_API_KEY=
# Optional: model slug and response token cap (defaults shown).
OPENROUTER_MODEL=google/gemini-3.1-flash-lite-preview
OPENROUTER_MAX_TOKENS=1024

# Supabase project used by the backend to verify user JWTs and run queries
# under Row-Level Security. Use the anon (public) key, NOT the service-role key.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=

# Comma- or newline-separated list of allowed CORS origins.
# The production Vercel origin is always added by the backend.
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Set to "production" to disable the interactive API docs (/docs, /redoc).
ENVIRONMENT=development

# Optional per-user rate limits (requests per minute).
# ANALYSIS_RATE_LIMIT_PER_MIN=10
# CHAT_RATE_LIMIT_PER_MIN=20

# Optional: override the classifier artifact locations
# (default: backend/data/sentiment_model.joblib and vectorizer.joblib).
# model_metadata.json is read from the model's directory.
# SENTIMIND_MODEL_PATH=
# SENTIMIND_VECTORIZER_PATH=

# ── Frontend (Vite; only VITE_* variables are exposed to the browser) ──────

# Required: the app throws on load without these.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=

# Backend base URL.
VITE_API_URL=http://localhost:8000/api/v1
