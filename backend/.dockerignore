# Never ship secrets or local state in the image.
.env
.venv/
__pycache__/
**/__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.python-version
tests/
docs/
*.egg-info/
.git
.gitignore

# Downloaded at build time by scripts/download_emotion_model.py — do not bake a
# stale/partial copy into the context; the build fetches the pinned, SHA-256-verified file.
app/models/emotion_onnx/
